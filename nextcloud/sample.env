# Compose
VOL_PATH=/data
# Regenerable data (previews, redis) — exclude from backups
VOL_CACHE=/var/cache
NEXTCLOUD_IMAGE=nextcloud:35
NEXTCLOUD_RESTART=unless-stopped
NEXTCLOUD_PORT=8084
MARIADB_IMAGE=mariadb:11.8
MARIADB_RESTART=unless-stopped
REDIS_IMAGE=redis:alpine
REDIS_RESTART=unless-stopped

# Database
NEXTCLOUD_DB=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=ChangeThisPassword
NEXTCLOUD_DB_HOST=nextcloud-db
MARIADB_ROOT_PASSWORD=ChangeThisPassword

# Nextcloud
NEXTCLOUD_REDIS_HOST=nextcloud-redis
# Public hostname served by NPM (no scheme)
NEXTCLOUD_DOMAIN=cloud.example.com
# Docker's default bridge range — covers NPM on the proxy network
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
NEXTCLOUD_OVERWRITEPROTOCOL=https
# Leave as-is for a fresh install. After install, set to
# /var/www/html/data/appdata_<instanceid>/preview  (see README → Volume Notes)
NEXTCLOUD_PREVIEW_DIR=/mnt/nextcloud-preview
