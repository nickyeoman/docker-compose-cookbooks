# MeTube
METUBE_IMAGE=ghcr.io/alexta69/metube:latest
METUBE_CONTAINER_NAME=metube
METUBE_PORT=8081
METUBE_RESTART=unless-stopped
METUBE_MEDIA=/data
METUBE_AUDIO_DOWNLOAD_DIR=/downloads/audio
METUBE_YTDL_OPTIONS=
METUBE_YTDL_OPTIONS_PRESETS={"Video + FLAC":{"keepvideo":true,"postprocessors":[{"key":"FFmpegExtractAudio","preferredcodec":"flac"}]}}
