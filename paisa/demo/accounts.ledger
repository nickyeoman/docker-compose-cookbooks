; Chart of accounts for Demolition Company Ltd.

commodity CAD
    format 1,000.00 CAD

commodity BTC
    format 1.00000000 BTC

; Assets
; Banks: BMO is the main operating account, RBC pays the crew,
; Scotiabank holds the excavator fund, CIBC holds money set aside for tax
account Assets:Bank:BMO:Chequing
account Assets:Bank:RBC:Payroll
account Assets:Bank:Scotiabank:Savings
account Assets:Bank:CIBC:TaxReserve
; Investments: a 1-year non-redeemable GIC and a bitcoin wallet
account Assets:Investments:GIC:CIBC
account Assets:Crypto:Wallet
account Assets:Cash
account Assets:AccountsReceivable
account Assets:GST:InputTaxCredits
account Assets:Equipment:Machinery
account Assets:Equipment:Vehicles
; Desks, chairs, computers, printer (consumable supplies go to Expenses:Office)
account Assets:Equipment:Office
; Hand tools: sledgehammers, pry bars, cordless saws and drills
account Assets:Equipment:Tools

; Liabilities
account Liabilities:CreditCard
account Liabilities:Loan:Equipment
account Liabilities:IncomeTax
account Liabilities:GST:Collected
account Liabilities:PST:Collected
account Liabilities:Payroll:CRA
account Liabilities:WorkSafeBC

; Equity
